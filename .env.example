# The origin of the published connector URL (PUBLIC_MCP_URL in
# server/src/public-url.ts). Drives the widget CSP lists and the ChatGPT-side
# widget domain; fly.toml sets the same value in production.
PUBLIC_APP_ORIGIN=https://airoicalculator-mcp.optimnow.io
OPENAI_APPS_CHALLENGE=replace-with-the-openai-verification-token

# Optional comma-separated overrides. Leave blank unless the widget needs them.
WIDGET_CONNECT_DOMAINS=
WIDGET_RESOURCE_DOMAINS=
WIDGET_REDIRECT_DOMAINS=
WIDGET_FRAME_DOMAINS=
